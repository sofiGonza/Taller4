# --- Taller4 frontend (Django) -------------------------------------------
# Copia este archivo a `.env` para desarrollo local. En producción (Vercel)
# estas mismas variables se configuran en Project Settings -> Environment
# Variables.

# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-al-azar

# DEBUG debe ser False en producción (Vercel).
DJANGO_DEBUG=True

# En producción incluye el dominio de Vercel, p.ej.:
# DJANGO_ALLOWED_HOSTS=taller4.vercel.app,.vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL pública del backend FastAPI ya desplegado (Render).
# En desarrollo local: http://127.0.0.1:8001
FASTAPI_BASE_URL=http://127.0.0.1:8001

# En desarrollo: SQLite local. En producción (Vercel): Postgres externo
# (Neon, Supabase, Vercel Postgres), p.ej. postgresql://user:pass@host:5432/db
# DATABASE_URL=postgresql://user:pass@host:5432/taller4
