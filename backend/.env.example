# --- Taller4 backend (FastAPI) -------------------------------------------
# Copia este archivo a `.env` para desarrollo local. En producción (Render)
# estas mismas variables se configuran en el dashboard / render.yaml.

# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave-por-una-generada-con-openssl-rand-hex-32

# Minutos de validez del JWT emitido por /auth/login.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# En desarrollo: SQLite local. En producción (Render): apunta a un Postgres
# externo, p.ej. postgresql://user:pass@host:5432/taller4
DATABASE_URL=sqlite:///./app.db

# Umbral LBPH (confianza). Cuanto MÁS BAJO, más parecido se exige.
LBPH_CONFIDENCE_THRESHOLD=60

# Fotos de referencia mínimas antes de bloquear el registro facial.
MIN_FACE_SAMPLES=3

# Orígenes permitidos por CORS, separados por coma. Incluye el dominio del
# frontend en Vercel y localhost para desarrollo.
# Ej. producción: https://tu-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
